; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Strike Kids"
config/description="Strike Kids - boliche infantil arcade com Bob e Mia (Lazer & Sport)"
config/version="1.0.0"
run/main_scene="res://cenas/principal.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.024, 0.078, 0.188, 1)
boot_splash/image="res://ui/splash.png"
config/icon="res://ui/icone_256.png"
boot_splash/image.android="res://ui/splash_giro_1.png"
config/quit_on_go_back=false

[autoload]

Tela="*res://autoload/Tela.gd"
Ajustes="*res://autoload/Ajustes.gd"
Sons="*res://autoload/Sons.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
Fotos="*res://autoload/Fotos.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


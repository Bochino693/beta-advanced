<?xml version="1.0" encoding="utf-8"?>
<!-- STRIKE KIDS - TESTE DO APARELHO: app pequeno (sem Godot) que mostra se a
     TV Box roda o jogo (placa de vídeo / OpenGL ES 3, Android, memória). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lazersport.testeaparelho">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />
    <application
        android:label="@string/nome"
        android:icon="@drawable/icone"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name="com.lazersport.testeaparelho.Teste"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
